{
  "name": "dsh-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Drawable DSH workspaces and a four-harness comparison using DeepSeek.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "configure": "node scripts/configure.mjs",
    "start": "node scripts/start.mjs",
    "install:harnesses": "node scripts/install-harnesses.mjs",
    "check": "node scripts/check-release.mjs && node scripts/check-docs.mjs",
    "build:viewer": "node scripts/build-viewer.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:cordis": "node scripts/check-cordis-plugin.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build:gallery": "node scripts/build-gallery.mjs"
  },
  "files": [
    "src",
    "scripts",
    "examples",
    "deploy",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "devDependencies": {
    "esbuild": "0.25.10",
    "three": "0.180.0"
  }
}
